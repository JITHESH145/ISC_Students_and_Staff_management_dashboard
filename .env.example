# Firebase VAPID key for Web Push (public identifier — safe in client)
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# ── Local emulator mode (optional, dev only) ──────────────────────
# When true, the app talks to the local Firebase Emulator Suite instead of the
# live project, so nothing you do locally touches production data.
# You normally don't set this by hand — `npm run dev:emulator` turns it on via
# .env.emulator. See scripts/seed-emulator.mjs to load real data into it.
# VITE_USE_EMULATOR=true
